# EasyLife 环境变量模板  ->  复制为 /etc/easylife/easylife.env 后填写（chmod 640, chown root:easylife）
#
# 该文件被 systemd 以 EnvironmentFile= 读取，语法限制：
#   * 只能写 KEY=VALUE，值不要用引号，**行尾不能写注释**（注释要单独占一行）；
#   * 空值写成 `KEY=`；
#   * EnvironmentFile 中的值会覆盖 .service 里 Environment= 的默认值。
#
# ⚠️ 安全须知：
#   * 本文件是密钥文件，绝不能提交进 git 仓库、也不能贴进聊天/工单；仓库里只保留本 *.example 模板；
#   * 下面所有 "<...>" 都是占位符，请务必替换；不要使用任何曾在聊天/文档中出现过的密码；
#   * 数据库 /var/lib/easylife/easylife.db 里可能保存网页端设置的 SMTP 密码（site_settings 表），
#     因此数据库文件与所有数据库备份都按密件对待（0600 / 目录 0700），不要拷贝到共享位置；
#   * 建议部署完成后立刻更换服务器 root 密码（见 docs/DEPLOY.md §2）。

# ---------------- 监听地址 ----------------
# 只监听回环地址：应用不直接对外，公网访问经由 nginx 反向代理。请勿改为 0.0.0.0。
EASYLIFE_HOST=127.0.0.1
# 监听端口；若 8086 已被占用，用 deploy.sh --port <端口> 重跑（会同步改这里和 nginx 片段的 proxy_pass）。
EASYLIFE_PORT=8086

# ---------------- 数据 ----------------
# SQLite 文件绝对路径（目录必须是 easylife 用户可写：/var/lib/easylife）。
EASYLIFE_DB=/var/lib/easylife/easylife.db

# ---------------- 密钥（必填，≥16 字符，缺失则拒绝启动）----------------
# 生成方式（不要用示例值）：
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# 用途：派生会话 CSRF token 的 HMAC 密钥（会话/HMAC 依赖它，缺失则拒绝启动）。
# 注意：日历订阅 token 存于 users.calendar_token，是每用户独立随机值（secrets.token_urlsafe），
#       与本密钥**无关**，因此更换本密钥**不会**让订阅 URL 失效；要轮换订阅地址请用
#       「日历订阅」面板的重置按钮（POST /api/calendar/token/reset）。
EASYLIFE_SECRET=<REPLACE_WITH_SECRET_AT_LEAST_16_CHARS>

# ---------------- 对外地址 ----------------
# 路径前缀：部署在 https://mch.wang/todos/（deploy.sh 默认的路径模式）时为 /todos，
# deploy.sh --mode path 每次都会写入 EASYLIFE_BASE_PATH=/todos 与 PUBLIC_URL=https://mch.wang/todos；
# 留空（EASYLIFE_BASE_PATH=）= 根路径部署（子域模式）。
#   * nginx 剥掉前缀转发（proxy_pass http://127.0.0.1:8086/;）或原样带前缀转发
#     （proxy_pass http://127.0.0.1:8086;）两种写法应用都兼容；
#   * 访问 /todos 会 301 跳到 /todos/；会话 Cookie 的 Path=/todos，不影响 mch.wang 上的其它服务。
EASYLIFE_BASE_PATH=/todos
# 浏览器可达的完整地址，不要以 "/" 结尾；https:// 开头时会话 Cookie 会自动带 Secure。
# 邮件里的任务链接、日历订阅 URL、Google 日历链接都以它为前缀。
# 写 https://mch.wang/todos 或 https://mch.wang 都可以：程序会保证末尾恰好带一次 EASYLIFE_BASE_PATH。
PUBLIC_URL=https://mch.wang/todos
# 旧变量名 BASE_URL 仍然兼容（PUBLIC_URL 优先）。子域方案示例：
#   EASYLIFE_BASE_PATH=
#   PUBLIC_URL=https://easylife.mch.wang

# ---------------- 邮件提醒 (SMTP) ----------------
# SMTP_HOST 留空 = 只写日志不真发信（日志模式），便于先跑通再补配置。
# deploy.sh 首次生成本文件时，若 SMTP_USER 仍是占位符会把 SMTP_HOST 清空（日志模式）；
# 可选：deploy.sh --smtp-host smtp.qq.com --smtp-user you@qq.com，授权码用环境变量
#       EASYLIFE_SMTP_PASS 传入（或在终端里交互输入），不要写在命令行参数里。
#   QQ 邮箱：  SMTP_HOST=smtp.qq.com   SMTP_PORT=465
#   163 邮箱： SMTP_HOST=smtp.163.com  SMTP_PORT=465
#   587 = STARTTLS，465 = SMTP_SSL（应用会自动选择）。
# 以下 SMTP 配置同时用于任务提醒、注册验证、找回密码；无需另配发信服务。
# SMTP_HOST：邮件服务商的 SMTP 服务器地址；留空时认证邮件正文只写服务器日志并输出 WARNING，
# 同时允许未验证邮箱登录。SMTP 已配置但发送失败时不会绕过验证要求。
SMTP_HOST=smtp.qq.com
# SMTP_PORT：连接端口，465 使用隐式 TLS，587 优先升级 STARTTLS。
SMTP_PORT=465
# SMTP_USER：SMTP 登录账号，通常是完整邮箱地址；留空适用于不要求认证的邮件中继。
SMTP_USER=<REPLACE_WITH_FULL_EMAIL_ADDRESS>
# ⚠️ 这里填的是邮箱的「SMTP 授权码 / 应用专用密码」，不是邮箱登录密码。
SMTP_PASS=<REPLACE_WITH_SMTP_AUTH_CODE>
# 发件人；缺省则使用 SMTP_USER。可写成  EasyLife <no-reply@example.com>
SMTP_FROM=

# ---------------- 管理员（网页邮件设置） ----------------
# 全站 SMTP 设置管理：逗号/空格分隔的现有账号 users.id（稳定 ID）；留空 = 无人有权限（默认）。
# 查询方式：sqlite3 /var/lib/easylife/easylife.db "SELECT id, email FROM users;"
#   （服务器没有 sqlite3 命令时： python3 -c "import sqlite3;print(*sqlite3.connect('/var/lib/easylife/easylife.db').execute('SELECT id,email FROM users'))"）
#   * 不存在的 ID 会被忽略并记录 WARNING（不授予任何权限）；删除账号后要同步更新本行；
#   * 邮箱永远不会被用来匹配管理员（新注册账号不会自动提权）；
#   * 网页保存的 SMTP 设置（含密码）存于数据库 site_settings 表，优先于本文件的 SMTP_*；密码不写回本文件；
#   * 改了本行必须重启服务： systemctl restart easylife
EASYLIFE_ADMIN_USER_IDS=

# ---------------- 行为参数 ----------------
# 提醒扫描间隔（秒）。测试时可临时改成 10，改完记得 systemctl restart easylife。
EASYLIFE_REMIND_INTERVAL=60
# 会话有效期（秒），默认 30 天。
EASYLIFE_SESSION_TTL=2592000

# ---------------- 邮箱验证 / 找回密码 ----------------
# 认证邮件里的公开地址，默认空（沿用 PUBLIC_URL / BASE_URL 和 EASYLIFE_BASE_PATH）。
# 线上请设置为 https://mch.wang/todos，验证链接形如 https://mch.wang/todos/#/verify?token=...
# 程序会补齐 EASYLIFE_BASE_PATH，不会重复添加 /todos；不应包含查询参数或 #。
# 此项或 PUBLIC_URL / BASE_URL 使用 HTTPS 时，会话 Cookie 自动带 Secure。
EASYLIFE_PUBLIC_URL=
# 默认 true：配置 SMTP 时，新用户须验证邮箱才能登录（老用户迁移后保持已验证）。
# false 允许未验证用户登录，但注册仍发送验证邮件；未配置 SMTP 时自动允许登录并警告。
# 验证链接 24 小时有效，重置链接 1 小时有效，均限一次使用；同一邮箱同类邮件间隔 60 秒。
EASYLIFE_REQUIRE_EMAIL_VERIFICATION=true
